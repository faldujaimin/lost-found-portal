msgid "That email address is already registered. Please use a different one."
msgstr "वह ईमेल पता पहले से पंजीकृत है। कृपया दूसरा उपयोग करें।"

#: app.py:1978
msgid "Registration failed: Duplicate entry detected."
msgstr "पंजीकरण विफल: डुप्लिकेट प्रविष्टि पाई गई।"

#: app.py:1980
#, python-format
msgid ""
"Registration failed due to a server error. Please try again. Error: "
"%(error)s"
